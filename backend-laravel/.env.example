APP_NAME="PLAUD Companion"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plaud_companion
DB_USERNAME=plaud
DB_PASSWORD=replace_with_db_password

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

JWT_SECRET_KEY=replace_with_64_char_secret

# Exposes /demo, which publishes seeded demo credentials. Never enable on a public server.
DEMO_LOGIN_ENABLED=false
UPDATER_PUBLIC_KEY=
UPDATER_FEED_URL=
UPDATER_FEED_ENABLED=false

# AI provider keys (server only — never expose in browser or mobile code)
# Free-tier providers (no credit card): Gemini → aistudio.google.com/apikey | Groq → console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Paid providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENROUTER_API_KEY=

# PLAUD Embedded partner credentials (server only; from dev.plaud.ai). Leave empty to keep device connection off.
PLAUD_API_BASE=https://platform-us.plaud.ai
PLAUD_CLIENT_ID=
PLAUD_CLIENT_SECRET=
