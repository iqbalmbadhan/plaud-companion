# ==============================================================================
# PLAUD Companion — Environment Template (Phase 1+)
# Copy to .env (backend) or web/.env.local (web) as needed.
# NEVER commit real secrets, API keys, or tokens.
# ==============================================================================

# --- Client Public Configuration (Safe for Next.js / Flutter) ---
NEXT_PUBLIC_APP_NAME="PLAUD Companion Admin"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_DEMO_MODE="true"

# --- Backend API & Database (Phase 2+) ---
DATABASE_URL="postgresql+asyncpg://plaud:plaud_dev@localhost:5432/plaud_companion"
REDIS_URL="redis://localhost:6379/0"
JWT_SECRET_KEY="replace-with-strong-random-secret"
JWT_ALGORITHM="HS256"

# --- Object Storage (Phase 3+) ---
S3_ENDPOINT_URL="http://localhost:9000"
S3_BUCKET_NAME="plaud-companion-private"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"

# --- AI Providers (Backend-Only, Phase 4+) ---
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# --- Plaud Official Embedded SDK / Partner API (Future Device Sync Phase) ---
PLAUD_CLIENT_ID=""
PLAUD_API_KEY=""
PLAUD_SERVER_DOMAIN="platform-us.plaud.ai"
